# Copy to .env for local development. In production these are supplied by
# 1Password and copied into the Vercel project's environment variables.

# Anthropic API key. Server-side only -- never exposed to the browser.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Shared passphrase that gates the demo. Anyone running the interview must
# enter this. Pick anything; it is compared in constant time.
DEMO_ACCESS_CODE=change-me

# Random secret used to sign the session cookie so it cannot be forged.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-32-random-bytes-hex
